# ==========================================
# PROCUREAI ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Configuration (Leave blank for instant high-fidelity local reactive store)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Developer Platform (Sandbox)
# Official PayPal Sandbox client id for testing or 'test' for interactive sandbox simulator
VITE_PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_SECRET=sandbox_secret_placeholder
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=webhook_placeholder

# AI Engine Configuration
# Supported providers: gemini | openai | anthropic
VITE_AI_PROVIDER=gemini
AI_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Application Server Port
PORT=3001
VITE_API_URL=http://localhost:3001
